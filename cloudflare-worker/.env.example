# Cloudflare Worker 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# Web 管理界面密码（必填）
WEB_PASSWORD=your_secure_password_here

# API 访问密钥（必填）
API_KEY=sk-your-api-key-here

# CodeBuddy API 端点（可选，默认值如下）
CODEBUDDY_API_ENDPOINT=https://www.codebuddy.ai

# 凭证轮换次数（可选，默认为 1）
# 每使用 N 次后自动切换到下一个凭证
ROTATION_COUNT=1

# 可用模型列表（可选，逗号分隔）
MODELS=auto-chat,gpt-5,gpt-5-mini,gpt-5-nano,claude-sonnet-4.5,claude-opus-4.5,claude-haiku-4.5,gemini-2.0-flash-exp,gemini-exp-1206,o1,o1-mini,o1-preview,o3-mini
